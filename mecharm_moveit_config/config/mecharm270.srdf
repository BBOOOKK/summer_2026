<?xml version="1.0"?>
<robot name="mecharm270_sim">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>
  <group name="gripper">
    <joint name="left_finger_joint"/>
    <joint name="right_finger_joint"/>
  </group>
  <end_effector name="parallel_gripper" parent_link="tool0" group="gripper"/>
  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/><joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/><joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/><joint name="joint6" value="0"/>
  </group_state>
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link5" reason="Never"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link6" reason="Never"/>
  <disable_collisions link1="link4" link2="tool0" reason="Never"/>
  <disable_collisions link1="link4" link2="left_finger" reason="Never"/>
  <disable_collisions link1="link4" link2="right_finger" reason="Never"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="left_finger" reason="Never"/>
  <disable_collisions link1="link5" link2="right_finger" reason="Never"/>
  <disable_collisions link1="link5" link2="tool0" reason="Never"/>
  <disable_collisions link1="link6" link2="left_finger" reason="Never"/>
  <disable_collisions link1="link6" link2="right_finger" reason="Never"/>
  <disable_collisions link1="tool0" link2="left_finger" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="right_finger" reason="Adjacent"/>
</robot>
