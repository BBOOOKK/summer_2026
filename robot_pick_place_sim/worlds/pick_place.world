<?xml version="1.0"?>
<sdf version="1.6">
  <world name="pick_place_world">
    <gravity>0 0 -9.81</gravity>
    <physics type="ode"><real_time_update_rate>1000</real_time_update_rate><max_step_size>0.001</max_step_size></physics>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <model name="work_table">
      <static>true</static><pose>0 0 0.375 0 0 0</pose>
      <link name="table"><collision name="collision"><geometry><box><size>0.9 0.7 0.75</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.9 0.7 0.75</size></box></geometry><material><ambient>0.34 0.20 0.10 1</ambient><diffuse>0.45 0.28 0.14 1</diffuse></material></visual></link>
    </model>
    <!-- Point A: relative to robot base at world z=0.75. -->
    <model name="target_object">
      <pose>0.22 0.12 0.77 0 0 0</pose>
      <link name="object"><inertial><mass>0.05</mass><inertia><ixx>0.000013</ixx><iyy>0.000013</iyy><izz>0.000013</izz></inertia></inertial><collision name="collision"><geometry><box><size>0.035 0.035 0.04</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="visual"><geometry><box><size>0.035 0.035 0.04</size></box></geometry><material><ambient>0.9 0.15 0.05 1</ambient><diffuse>0.9 0.15 0.05 1</diffuse></material></visual></link>
    </model>
    <model name="place_zone"><static>true</static><pose>0.20 -0.16 0.751 0 0 0</pose><link name="zone"><visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.002</length></cylinder></geometry><material><ambient>0.1 0.8 0.2 0.7</ambient><diffuse>0.1 0.8 0.2 0.7</diffuse></material></visual></link></model>
  </world>
</sdf>
