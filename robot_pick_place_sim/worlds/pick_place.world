<?xml version="1.0"?>
<sdf version="1.7">
  <world name="pick_place_world">
    <gravity>0 0 -9.81</gravity>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver><type>quick</type><iters>80</iters><sor>1.3</sor></solver>
        <constraints><cfm>0</cfm><erp>0.2</erp><contact_max_correcting_vel>0.1</contact_max_correcting_vel></constraints>
      </ode>
    </physics>
    <scene>
      <ambient>0.55 0.55 0.58 1</ambient>
      <background>0.08 0.10 0.14 1</background>
      <shadows>true</shadows>
    </scene>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>100.0</update_rate>
    </plugin>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="work_table">
      <static>true</static>
      <pose>0 0 0.375 0 0 0</pose>
      <link name="table">
        <collision name="table_collision"><geometry><box><size>0.9 0.7 0.75</size></box></geometry></collision>
        <visual name="table_visual"><geometry><box><size>0.9 0.7 0.75</size></box></geometry><material><ambient>0.34 0.20 0.10 1</ambient><diffuse>0.45 0.28 0.14 1</diffuse></material></visual>
        <sensor type="contact" name="table_contact_sensor">
          <always_on>true</always_on><update_rate>100</update_rate>
          <contact><collision>table_collision</collision></contact>
          <plugin name="table_contact_publisher" filename="libgazebo_ros_bumper.so">
            <ros><namespace>/gazebo</namespace><remapping>bumper_states:=contacts/table</remapping></ros>
            <frame_name>world</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <model name="pickup_zone_A">
      <static>true</static><pose>0.22 0.12 0.751 0 0 0</pose>
      <link name="zone"><visual name="visual"><geometry><cylinder><radius>0.055</radius><length>0.002</length></cylinder></geometry><material><ambient>0.1 0.85 0.2 0.65</ambient><diffuse>0.1 0.85 0.2 0.65</diffuse></material></visual></link>
    </model>

    <model name="place_zone_B">
      <static>true</static><pose>0.20 -0.16 0.751 0 0 0</pose>
      <link name="zone"><visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.002</length></cylinder></geometry><material><ambient>0.1 0.35 0.95 0.65</ambient><diffuse>0.1 0.35 0.95 0.65</diffuse></material></visual></link>
    </model>

    <model name="target_object">
      <pose>0.22 0.12 0.77 0 0 0</pose>
      <link name="object">
        <inertial><mass>0.05</mass><inertia><ixx>0.000013</ixx><iyy>0.000013</iyy><izz>0.000013</izz></inertia></inertial>
        <collision name="object_collision">
          <geometry><box><size>0.035 0.035 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.6</mu><mu2>1.6</mu2></ode></friction><contact><ode><kp>100000</kp><kd>10</kd><max_vel>0.1</max_vel><min_depth>0.0005</min_depth></ode></contact></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.035 0.035 0.04</size></box></geometry><material><ambient>0.95 0.08 0.04 1</ambient><diffuse>1 0.12 0.05 1</diffuse></material></visual>
        <sensor type="contact" name="target_contact_sensor">
          <always_on>true</always_on><update_rate>100</update_rate>
          <contact><collision>object_collision</collision></contact>
          <plugin name="target_contact_publisher" filename="libgazebo_ros_bumper.so">
            <ros><namespace>/gazebo</namespace><remapping>bumper_states:=contacts/target</remapping></ros>
            <frame_name>world</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <model name="grasp_plugin_carrier">
      <static>true</static><pose>0 0 -10 0 0 0</pose><link name="carrier"/>
      <plugin name="robot_grasp_joint" filename="librobot_grasp_joint.so">
        <ros><namespace>/</namespace></ros>
        <robot_model>mecharm270</robot_model><parent_link>tool0</parent_link>
        <target_model>target_object</target_model><target_link>object</target_link>
        <joint_name>physical_grasp_joint</joint_name>
        <contact_topic>/gazebo/contacts/target</contact_topic>
        <target_collision_token>target_object::</target_collision_token>
        <left_finger_collision_token>left_finger::</left_finger_collision_token>
        <right_finger_collision_token>right_finger::</right_finger_collision_token>
        <require_bilateral_contact>true</require_bilateral_contact>
        <contact_timeout>0.5</contact_timeout><max_attach_distance>0.10</max_attach_distance>
        <command_timeout>2.0</command_timeout>
        <attach_service>/grasp/attach</attach_service><detach_service>/grasp/detach</detach_service>
        <status_service>/grasp/status</status_service><state_topic>/grasp/state</state_topic>
      </plugin>
    </model>
  </world>
</sdf>
