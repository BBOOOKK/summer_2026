<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pick_place">
    <physics name="fast_stable" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><direction>-0.4 0.2 -1</direction></light>
    <model name="work_table" canonical_link="table"><static>true</static>
      <link name="table"><pose>0 0 0.375 0 0 0</pose>
        <visual name="table_visual"><geometry><box><size>1.2 0.8 0.75</size></box></geometry><material><diffuse>0.35 0.22 0.12 1</diffuse></material></visual>
        <collision name="table_collision"><geometry><box><size>1.2 0.8 0.75</size></box></geometry></collision>
        <sensor name="table_contacts" type="contact"><always_on>true</always_on><update_rate>100</update_rate><contact><collision>table_collision</collision><topic>/gazebo/contacts/table</topic></contact></sensor>
      </link>
    </model>
    <model name="target_object" canonical_link="object">
      <!-- Startup staging keeps the passive mimic finger unobstructed.  The
           object manager restores the audited A pose at every run. -->
      <pose>0.50 0.30 0.7675 0 0 0.499</pose><link name="object">
        <inertial><mass>0.05</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <visual name="object_visual"><geometry><box><size>0.05 0.05 0.035</size></box></geometry><material><diffuse>0.9 0.15 0.08 1</diffuse></material></visual>
        <collision name="object_collision"><geometry><box><size>0.05 0.05 0.035</size></box></geometry><surface><friction><ode><mu>0.20</mu><mu2>0.20</mu2></ode></friction></surface></collision>
        <sensor name="target_contacts" type="contact"><always_on>true</always_on><update_rate>100</update_rate><contact><collision>object_collision</collision><topic>/gazebo/contacts/target</topic></contact></sensor>
      </link>
    </model>
    <model name="pickup_zone_A"><static>true</static><pose>0.22 0.12 0.751 0 0 0</pose><link name="mark"><visual name="v"><geometry><cylinder><radius>0.055</radius><length>0.002</length></cylinder></geometry><material><diffuse>0.1 0.8 0.2 0.7</diffuse></material></visual></link></model>
    <model name="place_zone_B"><static>true</static><pose>0.20 -0.16 0.751 0 0 0</pose><link name="mark"><visual name="v"><geometry><cylinder><radius>0.07</radius><length>0.002</length></cylinder></geometry><material><diffuse>0.1 0.3 0.9 0.7</diffuse></material></visual></link></model>
  </world>
</sdf>
