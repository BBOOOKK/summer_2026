<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pick_place">
    <physics name="fast_stable" type="ignored">
      <!-- 200 Hz is above the 100 Hz controller/contact requirements while
           keeping real-time factor near 1 on the supported ARM host. -->
      <max_step_size>0.005</max_step_size>
      <real_time_update_rate>200</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.55 0.58 0.64 1</ambient>
      <background>0.12 0.15 0.20 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><direction>-0.4 0.2 -1</direction>
      <diffuse>0.85 0.82 0.76 1</diffuse><specular>0.18 0.18 0.18 1</specular>
    </light>
    <light type="point" name="fill_light">
      <pose>0.6 0.8 1.8 0 0 0</pose><diffuse>0.50 0.58 0.72 1</diffuse>
      <specular>0.08 0.08 0.08 1</specular><attenuation><range>5</range><constant>0.7</constant><linear>0.15</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <model name="studio_floor"><static>true</static>
      <link name="floor">
        <collision name="floor_collision"><geometry><box><size>5 5 0.04</size></box></geometry></collision>
        <visual name="floor_visual"><geometry><box><size>5 5 0.04</size></box></geometry><material><diffuse>0.15 0.18 0.23 1</diffuse><specular>0.04 0.04 0.04 1</specular></material></visual>
      </link>
    </model>
    <model name="work_table" canonical_link="table"><static>true</static>
      <link name="table">
        <visual name="tabletop_visual"><pose>0 0 0.725 0 0 0</pose><geometry><box><size>1.2 0.8 0.05</size></box></geometry><material><diffuse>0.34 0.16 0.075 1</diffuse><specular>0.18 0.11 0.07 1</specular></material></visual>
        <collision name="table_collision"><pose>0 0 0.725 0 0 0</pose><geometry><box><size>1.2 0.8 0.05</size></box></geometry></collision>
        <visual name="front_apron"><pose>0 -0.36 0.63 0 0 0</pose><geometry><box><size>1.12 0.06 0.16</size></box></geometry><material><diffuse>0.24 0.10 0.045 1</diffuse></material></visual>
        <visual name="back_apron"><pose>0 0.36 0.63 0 0 0</pose><geometry><box><size>1.12 0.06 0.16</size></box></geometry><material><diffuse>0.24 0.10 0.045 1</diffuse></material></visual>
        <visual name="leg_fl"><pose>0.52 -0.32 0.35 0 0 0</pose><geometry><box><size>0.07 0.07 0.70</size></box></geometry><material><diffuse>0.20 0.08 0.035 1</diffuse></material></visual>
        <visual name="leg_fr"><pose>0.52 0.32 0.35 0 0 0</pose><geometry><box><size>0.07 0.07 0.70</size></box></geometry><material><diffuse>0.20 0.08 0.035 1</diffuse></material></visual>
        <visual name="leg_bl"><pose>-0.52 -0.32 0.35 0 0 0</pose><geometry><box><size>0.07 0.07 0.70</size></box></geometry><material><diffuse>0.20 0.08 0.035 1</diffuse></material></visual>
        <visual name="leg_br"><pose>-0.52 0.32 0.35 0 0 0</pose><geometry><box><size>0.07 0.07 0.70</size></box></geometry><material><diffuse>0.20 0.08 0.035 1</diffuse></material></visual>
        <sensor name="table_contacts" type="contact"><always_on>true</always_on><update_rate>100</update_rate><contact><collision>table_collision</collision><topic>/gazebo/contacts/table</topic></contact></sensor>
      </link>
    </model>
    <model name="target_object" canonical_link="object">
      <!-- Startup staging keeps the passive mimic finger unobstructed.  The
           object manager restores the audited A pose at every run. -->
      <pose>0.50 0.30 0.7675 0 0 0.499</pose><link name="object">
        <inertial><mass>0.05</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
        <visual name="object_visual"><geometry><box><size>0.066 0.066 0.035</size></box></geometry><material><diffuse>0.9 0.15 0.08 1</diffuse></material></visual>
        <collision name="object_collision"><geometry><box><size>0.066 0.066 0.035</size></box></geometry><surface><friction><ode><mu>0.20</mu><mu2>0.20</mu2></ode></friction></surface></collision>
        <sensor name="target_contacts" type="contact"><always_on>true</always_on><update_rate>100</update_rate><contact><collision>object_collision</collision><topic>/gazebo/contacts/target</topic></contact></sensor>
      </link>
    </model>
    <model name="pickup_zone_A"><static>true</static><pose>0.22 0.12 0.751 0 0 0</pose><link name="mark"><visual name="v"><geometry><cylinder><radius>0.055</radius><length>0.002</length></cylinder></geometry><material><diffuse>0.1 0.8 0.2 0.7</diffuse></material></visual></link></model>
    <model name="place_zone_B"><static>true</static><pose>0.20 -0.16 0.751 0 0 0</pose><link name="mark"><visual name="v"><geometry><cylinder><radius>0.07</radius><length>0.002</length></cylinder></geometry><material><diffuse>0.1 0.3 0.9 0.7</diffuse></material></visual></link></model>
    <model name="demo_camera"><static>true</static>
      <pose>1.45 1.10 1.42 0 0.31 -2.49</pose>
      <link name="camera_link">
        <sensor name="presentation_camera" type="camera">
          <always_on>true</always_on><update_rate>30</update_rate><topic>/demo_camera/image</topic>
          <camera><horizontal_fov>1.05</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.05</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
