<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mecharm270_sim">
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="simulator" default="classic"/>
  <xacro:property name="simulator_backend" value="$(arg simulator)"/>
  <xacro:property name="arm_radius" value="0.026"/>

  <xacro:macro name="contact_sensor" params="link collision topic:=/gazebo/contacts/robot">
    <gazebo reference="${link}">
      <sensor type="contact" name="${link}_contact_sensor">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact><collision>${collision}</collision><topic>${topic}</topic></contact>
        <xacro:if value="${simulator_backend == 'classic'}">
        <plugin name="${link}_contact_publisher" filename="libgazebo_ros_bumper.so">
          <ros>
            <namespace>/gazebo</namespace>
            <remapping>bumper_states:=contacts/robot</remapping>
          </ros>
          <frame_name>world</frame_name>
        </plugin>
        </xacro:if>
      </sensor>
    </gazebo>
  </xacro:macro>

  <material name="white"><color rgba="0.92 0.92 0.92 1"/></material>
  <material name="blue"><color rgba="0.10 0.35 0.80 1"/></material>
  <material name="dark"><color rgba="0.08 0.08 0.10 1"/></material>
  <xacro:property name="cad_mesh_root"
                  value="package://robot_pick_place_sim/meshes/mecharm_270_m5"/>

  <!-- The world joint represents the bolted base required by the experiment.
       Its 0.75 m offset is shared by Gazebo and TF, avoiding a second transform. -->
  <link name="world"/>
  <joint name="world_fixed_joint" type="fixed">
    <parent link="world"/><child link="base_footprint"/>
    <origin xyz="0 0 0.75"/>
  </joint>
  <!-- Inertia-free frame keeps the KDL root path valid. -->
  <link name="base_footprint"/>
  <joint name="base_fixed" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
  </joint>

  <xacro:macro name="cad_link"
               params="name visual_xyz visual_rpy collision_xyz collision_size mass:=0.25">
    <link name="${name}">
      <inertial><origin xyz="${collision_xyz}"/><mass value="${mass}"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
      <visual><origin xyz="${visual_xyz}" rpy="${visual_rpy}"/><geometry><mesh filename="${cad_mesh_root}/${name}.dae"/></geometry></visual>
      <collision name="${name}_collision"><origin xyz="${collision_xyz}"/><geometry><box size="${collision_size}"/></geometry></collision>
    </link>
  </xacro:macro>

  <link name="base_link">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 -${pi}"/><geometry><mesh filename="${cad_mesh_root}/base.dae"/></geometry></visual>
    <collision name="base_link_collision"><origin xyz="0 0 0.035"/><geometry><cylinder radius="0.075" length="0.07"/></geometry></collision>
  </link>
  <xacro:cad_link name="link1" visual_xyz="0 0 -0.132" visual_rpy="0 0 0"
                  collision_xyz="0 0 0.019" collision_size="0.08 0.08 0.07" mass="0.5"/>
  <xacro:cad_link name="link2" visual_xyz="-0.005 0.21 0.002" visual_rpy="1.5708 -${pi} 0"
                  collision_xyz="0 -0.05 0" collision_size="0.06 0.11 0.06"/>
  <xacro:cad_link name="link3" visual_xyz="-0.09 0.306 0.005" visual_rpy="1.5708 ${pi} 0"
                  collision_xyz="0.054 -0.0025 0" collision_size="0.12 0.06 0.06"/>
  <xacro:cad_link name="link4" visual_xyz="0.009 -0.311 -0.228" visual_rpy="0 1.5708 1.5708"
                  collision_xyz="0 0 0" collision_size="0.07 0.07 0.07"/>
  <xacro:cad_link name="link5" visual_xyz="-0.292 -0.318 -0.007" visual_rpy="1.5708 0 ${pi}"
                  collision_xyz="0.03 0 0" collision_size="0.07 0.06 0.06"/>
  <xacro:cad_link name="link6" visual_xyz="-0.1645 0.0536 -0.211" visual_rpy="0 1.5708 0"
                  collision_xyz="0 0 0.019" collision_size="0.06 0.06 0.07"/>

  <xacro:macro name="arm_joint" params="name parent child xyz rpy lower upper">
    <joint name="${name}" type="revolute"><parent link="${parent}"/><child link="${child}"/><origin xyz="${xyz}" rpy="${rpy}"/><axis xyz="0 0 1"/><limit lower="${lower}" upper="${upper}" effort="30" velocity="1.5"/><dynamics damping="0.15" friction="0.05"/></joint>
  </xacro:macro>
  <xacro:arm_joint name="joint1" parent="base_link" child="link1" xyz="0 0 0.1" rpy="0 0 0" lower="-2.792527" upper="2.792527"/>
  <xacro:arm_joint name="joint2" parent="link1" child="link2" xyz="0 0 0.038" rpy="-${pi/2} 0 0" lower="-1.3089" upper="2.0943"/>
  <xacro:arm_joint name="joint3" parent="link2" child="link3" xyz="0 -0.1 0" rpy="0 0 0" lower="-3.0543" upper="1.1344"/>
  <xacro:arm_joint name="joint4" parent="link3" child="link4" xyz="0.108 -0.005 -0.001" rpy="0 ${pi/2} 0" lower="-2.7052" upper="2.7052"/>
  <xacro:arm_joint name="joint5" parent="link4" child="link5" xyz="-0.001 0 0" rpy="0 -${pi/2} 0" lower="-2.0071" upper="2.0071"/>
  <xacro:arm_joint name="joint6" parent="link5" child="link6" xyz="0.06 0 0" rpy="0 ${pi/2} 0" lower="-${pi}" upper="${pi}"/>

  <link name="tool0"><visual><origin xyz="0 0 -0.006"/><geometry><cylinder radius="0.034" length="0.025"/></geometry><material name="dark"/></visual><collision name="tool0_collision"><origin xyz="0 0 -0.006"/><geometry><cylinder radius="0.010" length="0.020"/></geometry></collision><inertial><mass value="0.08"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial></link>
  <joint name="tool_fixed" type="fixed"><parent link="link6"/><child link="tool0"/><origin xyz="0 0 0.038" rpy="1.579 0 0"/></joint>
  <!-- The compensated child transforms retain vertical finger geometry while
       preserving the non-singular DART joint frames used by both backends. -->
  <link name="left_finger"><visual><origin xyz="-0.031123 0 0.025127" rpy="0 2.25 0"/><geometry><box size="0.012 0.012 0.06"/></geometry><material name="blue"/></visual><collision name="left_finger_collision"><origin xyz="-0.031123 0 0.025127" rpy="0 2.25 0"/><geometry><box size="0.012 0.012 0.06"/></geometry></collision><inertial><mass value="0.03"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial></link>
  <joint name="left_finger_joint" type="prismatic"><parent link="tool0"/><child link="left_finger"/><origin xyz="0 0.006 0" rpy="0 -2.25 0"/><axis xyz="0 1 0"/><limit lower="0.012" upper="0.032" effort="15" velocity="0.08"/><dynamics damping="0.35" friction="0.05"/></joint>
  <!-- mechArm's single-motor linkage is represented by one actuated pivoting
       jaw.  This avoids the DART parallel-prismatic lock while retaining
       physical two-sided contact against the fixed jaw. -->
  <link name="right_finger"><visual><origin xyz="0 -0.018 -0.04"/><geometry><box size="0.012 0.012 0.06"/></geometry><material name="blue"/></visual><collision name="right_finger_collision"><origin xyz="0 -0.018 -0.04"/><geometry><box size="0.012 0.012 0.06"/></geometry></collision><inertial><mass value="0.03"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial></link>
  <joint name="right_finger_joint" type="revolute"><parent link="tool0"/><child link="right_finger"/><origin xyz="0 -0.006 0"/><axis xyz="1 0 0"/><limit lower="-0.40" upper="0.20" effort="15" velocity="0.8"/><dynamics damping="0.35" friction="0.05"/></joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <xacro:if value="${simulator_backend == 'classic'}"><plugin>gazebo_ros2_control/GazeboSystem</plugin></xacro:if>
      <xacro:if value="${simulator_backend == 'fortress'}"><plugin>gz_ros2_control/GazeboSimSystem</plugin></xacro:if>
    </hardware>
    <xacro:macro name="controlled_joint" params="name initial:=0.0">
      <joint name="${name}"><command_interface name="position"><param name="min">-3.14</param><param name="max">3.14</param></command_interface><state_interface name="position"><param name="initial_value">${initial}</param></state_interface><state_interface name="velocity"/></joint>
    </xacro:macro>
    <xacro:controlled_joint name="joint1"/><xacro:controlled_joint name="joint2"/><xacro:controlled_joint name="joint3"/>
    <xacro:controlled_joint name="joint4"/><xacro:controlled_joint name="joint5"/><xacro:controlled_joint name="joint6"/>
    <joint name="left_finger_joint"><command_interface name="position"><param name="min">0.012</param><param name="max">0.032</param></command_interface><state_interface name="position"><param name="initial_value">0.032</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="right_finger_joint"><command_interface name="position"><param name="min">-0.40</param><param name="max">0.20</param></command_interface><state_interface name="position"><param name="initial_value">-0.35</param></state_interface><state_interface name="velocity"/></joint>
  </ros2_control>
  <xacro:if value="${simulator_backend == 'classic'}"><gazebo>
    <!-- Primitive link envelopes overlap at several legal mechArm poses.
         Gazebo self-collision is therefore disabled; sampled capsule clearance
         validation handles non-adjacent self-collision without destabilising ODE. -->
    <self_collide>false</self_collide>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control"><parameters>$(arg controllers_file)</parameters></plugin>
  </gazebo></xacro:if>
  <xacro:if value="${simulator_backend == 'fortress'}"><gazebo>
    <self_collide>false</self_collide>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <!-- Track MoveIt trajectories closely without exceeding the documented
           non-oscillating gain bound (position error -> joint velocity). -->
      <position_proportional_gain>0.5</position_proportional_gain>
      <ros><remapping>/joint_states:=/fortress/joint_states_raw</remapping></ros>
    </plugin>
    <plugin filename="ignition-gazebo-detachable-joint-system" name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>tool0</parent_link><child_model>target_object</child_model><child_link>object</child_link>
      <attach_topic>/grasp/attach_cmd</attach_topic><detach_topic>/grasp/detach_cmd</detach_topic>
      <output_topic>/grasp/attached</output_topic>
    </plugin>
  </gazebo></xacro:if>
  <gazebo reference="tool_fixed"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="left_finger"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>
  <gazebo reference="right_finger"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>

  <xacro:if value="${simulator_backend == 'classic'}">
  <xacro:contact_sensor link="base_link" collision="base_link_collision"/>
  <xacro:contact_sensor link="link1" collision="link1_collision"/>
  <xacro:contact_sensor link="link2" collision="link2_collision"/>
  <xacro:contact_sensor link="link3" collision="link3_collision"/>
  <xacro:contact_sensor link="link4" collision="link4_collision"/>
  <xacro:contact_sensor link="link5" collision="link5_collision"/>
  <xacro:contact_sensor link="link6" collision="link6_collision"/>
  <xacro:contact_sensor link="tool0" collision="tool0_collision"/>
  <xacro:contact_sensor link="left_finger" collision="left_finger_collision"/>
  <xacro:contact_sensor link="right_finger" collision="right_finger_collision"/>
  </xacro:if>
  <xacro:if value="${simulator_backend == 'fortress'}">
    <!-- Fortress contact sensors on dynamic objects only emit while contact
         exists, so each finger has an independent physical source. -->
    <xacro:contact_sensor link="left_finger" collision="left_finger_collision"
                          topic="/gazebo/contacts/left_finger"/>
    <xacro:contact_sensor link="right_finger" collision="right_finger_collision"
                          topic="/gazebo/contacts/right_finger"/>
  </xacro:if>
</robot>
