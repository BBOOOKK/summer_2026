.DS_Store
**/.DS_Store
__pycache__/
*.py[cod]
*.cache
.venv/
venv/

# iCloud conflict copies; canonical YOLO labels have no numeric suffix.
data/annotated/labels/**/* 2.txt

# ROS2 and local build products
desktop_object_detection/ros2_ws/build/
desktop_object_detection/ros2_ws/install/
desktop_object_detection/ros2_ws/log/

# Unreferenced Open Images download cache. The 4,500 images used by the
# expanded dataset are explicitly tracked with Git LFS.
desktop_object_detection/datasets/p05_expanded_v1/sources/

# Local-only scratch files
work/

# LAB4 local environment and generated report previews
.venv-lab4/
Lab4/**/report/build/
Lab4/**/report/source/figures/icra_*.png
Lab4/**/report/source/figures/team_*.png
Lab4/**/report/source/figures/pipeline_*.png
Lab4/**/report/source/figures/*.svg

# Training runs duplicate the canonical weights stored under models/.
desktop_object_detection/outputs/training/*/weights/
